# Dockerfile for Debian 13 (testing) with systemd, sudo, and ansible user
FROM debian:13-slim

# Install systemd, sudo, and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd-sysv \
        sudo \
        util-linux && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non‑privileged ansible user with passwordless sudo
RUN useradd -m -G sudo ansible && \
    echo 'ansible ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ansible && \
    chmod 0440 /etc/sudoers.d/ansible

STOPSIGNAL SIGRTMIN+3

CMD ["/usr/sbin/init"]
